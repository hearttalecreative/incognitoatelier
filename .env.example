# Backend endpoint that forwards form submissions to Brevo.
# Point this at the Supabase Edge Function (or any serverless route) that holds
# the Brevo API key server-side. The key itself must never live in this file.
VITE_FORMS_ENDPOINT=https://YOUR-PROJECT.supabase.co/functions/v1

# Supabase project, only needed once the backend is wired up.
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
